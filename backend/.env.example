# Copy to backend/.env and set the URL for your local database.
DATABASE_URL=postgresql+asyncpg://codescape:CHANGE_ME@localhost:5432/codescape

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_REASONING_MODEL=gemini-3.8-flash
GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# Optional single-process development fallback when Redis is unset.
REDIS_URL=

# Relative paths resolve against the repository root.
REPOS_STORAGE_PATH=data/repos
EPHEMERAL_RUNS_PATH=data/runs
SANDBOX_IMAGE_TAG=codescape-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=8
DEMO_MODE=false
CORS_ORIGINS=http://localhost:5173
